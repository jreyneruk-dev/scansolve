# Supabase
NEXT_PUBLIC_SUPABASE_URL=xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Resend (email notifications)
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Credential encryption (32 random chars, or 64-char hex)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_char_or_64_hex_key_here

# Anthropic (Phase 3 - AI suggestions)
# ANTHROPIC_API_KEY=sk-ant-your-key

# Google AI (support chat widget — Gemini 2.0 Flash)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Google AdSense (revenue ads on the public reporter page, free tier only)
# Publisher ID (ca-pub-...) is hardcoded in app/layout.tsx for site verification.
# Once AdSense approves scansolve.co, create a Display ad unit and set its slot
# id below to flip on real ads. Leave unset to keep the house-ad fallback.
# NEXT_PUBLIC_ADSENSE_SLOT=xxxxxxxxxx

# Twilio (Prime SMS/WhatsApp issue alerts) — all server-only
# Account SID + Auth Token from the Twilio console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Verify service (Console → Verify → Services) — handles the OTP send/check.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sending numbers (E.164). SMS = a Twilio phone number; WhatsApp = your
# approved WhatsApp sender number (without the "whatsapp:" prefix).
TWILIO_SMS_FROM=+14155551234
TWILIO_WHATSAPP_FROM=+14155551234
